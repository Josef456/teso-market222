NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teso_market
DATABASE_SSL=false
SESSION_SECRET=change-me-to-a-long-random-string
IPN_SECRET=change-me-another-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-12chars+
# Pesapal (sandbox keys from https://developer.pesapal.com ; use PESAPAL_ENV=live only after approval)
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
# Optional SMTP for password-reset emails (without it, reset links are written to the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Teso Market <no-reply@example.com>"
